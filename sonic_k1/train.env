# sonic_k1 training environment — sourced by the Linux training scripts (S3 bundle contract:
# sonic_k1/{patches/*.patch, overlay/**, data/robot/*.pkl, train.env}). Paths relative to the sonic_k1/ dir
# unless absolute. Values here are the K1 defaults; override on the command line, not by editing per run.
SONIC_ROBOT=k1
SONIC_EXP=manager/universal_token/all_modes/sonic_k1
SONIC_PROJECT=TRL_K1_Track
# motion library: directory of K1 PKLs (scripts/k1_csv_to_pkl.py output); loaded recursively
SONIC_MOTION_FILE=data/robot
# SMPL encoder data matching the robot motion keys; "dummy" = placeholder SMPL generated from robot motions
SONIC_SMPL_MOTION_FILE=dummy
# 16 for the first smoke run (headless=False to watch), 4096 per GPU for real training
SONIC_NUM_ENVS=4096
# fail fast if Isaac Lab's articulation order differs from overlay robots/k1.py (patches/0002)
SONIC_STRICT_ROBOT_ORDER=1
