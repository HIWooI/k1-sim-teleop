# GPU fence: source before a k1live run on a machine whose NVIDIA GPU must stay untouched (CPU-only runs, e.g. a GPU
# driver that is not trusted under CUDA + EGL load). Everything renders on the CPU (Mesa llvmpipe),
# GEM-X cannot start (no CUDA, no GEM-X python -> the service runs MediaPipe), and scripts/ops/nvidia_watch.py
# kills the run the moment any of our processes maps an NVIDIA library or opens an NVIDIA device node.
#   . scripts/ops/cpu_only.env
export __EGL_VENDOR_LIBRARY_FILENAMES=/usr/share/glvnd/egl_vendor.d/50_mesa.json   # glvnd loads Mesa EGL only
export __GLX_VENDOR_LIBRARY_NAME=mesa
export LIBGL_ALWAYS_SOFTWARE=1 GALLIUM_DRIVER=llvmpipe EGL_PLATFORM=surfaceless
export VK_DRIVER_FILES=/usr/share/vulkan/icd.d/lvp_icd.json VK_ICD_FILENAMES=/usr/share/vulkan/icd.d/lvp_icd.json
export CUDA_VISIBLE_DEVICES=
export MUJOCO_GL=egl                       # MuJoCo EGL -> Mesa llvmpipe (OSMesa is often not installed)
export K1LIVE_GEMX_PYTHON=/nonexistent/gemx-python   # GEM-X: "python not found" -> exit 5 -> MediaPipe, torch never imported
export MOZ_WEBRENDER=0                     # Firefox: software compositor
export K1DEMO_CHROME_ARGS="--disable-gpu --use-angle=swiftshader --disable-vulkan"
export K1_FENCE="${K1_FENCE:-k1fence-$$}"  # every process of the run inherits it -> nvidia_watch.py finds them by it
